'translate(-249.000000, -126.000000)' fill='%23FFFFFF'%3E%3Crect x='249' y='126' width='1' height='1'%3E%3C/rect%3E%3C/g%3E%3C/g%3E%3C/svg%3E\" _width=\"100%\" alt=\"图片\"></section></section></section></section><section style=\"margin: 15px 0px;box-sizing: border-box;\"><section style=\"text-align: justify;font-size: 14px;letter-spacing: 1.5px;line-height: 2;padding: 0px 20px;box-sizing: border-box;\"><p style=\"white-space: normal;margin: 0px;padding: 0px;box-sizing: border-box;\"><span leaf=\"\">博望餐饮法务咨询团队始终致力于为餐饮行业深度赋能。</span><strong style=\"box-sizing: border-box;\"><span leaf=\"\">2025年，博望团队每月都精心准备了法务课程，旨在帮助餐饮企业在复杂多变的市场环境中稳健发展，降低运营风险，提升企业竞争力。</span></strong></p><p style=\"white-space: normal;margin: 0px;padding: 0px;box-sizing: border-box;\"><span leaf=\"\"><br></span></p><p style=\"text-align: center;white-space: normal;margin: 0px;padding: 0px;box-sizing: border-box;\"><span style=\"color: rgb(244, 70, 53);box-sizing: border-box;\"><strong style=\"box-sizing: border-box;\"><span leaf=\"\">感兴趣的伙伴添加客服微信报名～</span></strong></span></p></section></section><section style=\"margin-top: 10px;margin-bottom: 10px;line-height: 0;box-sizing: border-box;\"><section style=\"max-width: 100%;vertical-align: middle;display: inline-block;line-height: 0;box-sizing: border-box;\" nodeleaf=\"\"><img class=\"rich_pages wxw-img js_img_placeholder wx_img_placeholder\" data-ratio=\"3.662037037037037\" data-s=\"300,640\" data-src=\"https://mmbiz.qpic.cn/mmbiz_jpg/jNSvMVkX72I9PRwbgW9wibQAib7u61ghIbScGtYReoFAoto3dlUCzNZFa2RicDWFGeuNiaCsjNd0n8ibU9tK8zJx9vw/640?wx_fmt=jpeg#imgIndex=14\" data-w=\"1080\" style=\"vertical-align: middle; max-width: 100%; box-sizing: border-box; aspect-ratio: calc(0.273072) / 1; width: 607px !important; height: auto !important;\" data-original-style=\"vertical-align: middle;max-width: 100%;width: 100%;box-sizing: border-box;\" data-index=\"17\" src=\"data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg width='1px' height='1px' viewBox='0 0 1 